# Copy this file to .env.7gpu and replace every GPU UUID.
# Obtain stable UUIDs with: nvidia-smi --query-gpu=index,uuid --format=csv,noheader

# The Ollama image digest is pinned directly in compose.ollama-7gpu.yaml.

GPU_0_UUID=GPU-replace-with-uuid-0
GPU_1_UUID=GPU-replace-with-uuid-1
GPU_2_UUID=GPU-replace-with-uuid-2
GPU_3_UUID=GPU-replace-with-uuid-3
GPU_4_UUID=GPU-replace-with-uuid-4
GPU_5_UUID=GPU-replace-with-uuid-5
GPU_6_UUID=GPU-replace-with-uuid-6
